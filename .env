AI__LLM_API_KEY="sk-nu4XTKwYyNN9LhO53iEfRbmhSnmz0As4LHzfxozYTph7huWO"

AI__EMBEDDING_PROVIDER="gapgpt"
AI__EMBEDDING_MODEL="text-embedding-ada-002"
