# ==========================================
# Database Settings (Vector & Relational)
# ==========================================
DB__QDRANT_URL=http://localhost:6333
DB__QDRANT_PATH=""
DB__QDRANT_COLLECTION="iust_knowledge"
DB__MYSQL_DSN="mysql+pymysql://user:password@localhost:3306/db_name"

# ==========================================
# Ingestion Settings (Chunking & Processing)
# ==========================================
INGESTION__DATA_DIR="./data"
INGESTION__INPUT_DIR="./inputs"
INGESTION__CHUNK_SIZE=1000
INGESTION__CHUNK_OVERLAP=200
INGESTION__DEFAULT_FOLDERS=["public"]
