# ==========================================
# General Settings
# ==========================================
APP_NAME="IUST RAG System AI-Worker"
DEBUG=True
API_PREFIX="/api/v1"

# ==========================================
# Laravel Settings (Communication & Storage)
# ==========================================
LARAVEL__BASE_URL=http://127.0.0.1:8000
LARAVEL__VERIFY_TOKEN_ENDPOINT="/api/v1/auth/verify-token"
LARAVEL__SHARED_STORAGE_PATH="/app/shared_storage"
LARAVEL__INTERNAL_API_KEY=IUST-KNOWLEDGE-BASE

# ==========================================
# AI Settings (LLM, Embeddings & Vision)
# ==========================================
