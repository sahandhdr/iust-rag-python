AI__EMBEDDING_API_KEY="sk-nu4XTKwYyNN9LhO53iEfRbmhSnmz0As4LHzfxozYTph7huWO"

AI__VISION_PROVIDER="gapgpt"
AI__VISION_API_KEY="sk-nu4XTKwYyNN9LhO53iEfRbmhSnmz0As4LHzfxozYTph7huWO"
AI__GAPGPT_VISION_MODEL="gpt-4o-mini"

# API Keys & URLs
AI__OPENAI_API_KEY="sk-nu4XTKwYyNN9LhO53iEfRbmhSnmz0As4LHzfxozYTph7huWO"
AI__GAPGPT_API_KEY="sk-nu4XTKwYyNN9LhO53iEfRbmhSnmz0As4LHzfxozYTph7huWO"
